# SceneWeaver local development / harness overrides.
# Creators: prefer Setup Wizard + Settings UI (`uv run sceneweaver start` → /setup).
# Env still wins for e2e / live-test (SCENEWEAVER_ENVIRONMENT=e2e|live-test).
SCENEWEAVER_ENVIRONMENT=development
SCENEWEAVER_HOST=127.0.0.1
SCENEWEAVER_PORT=8000
SCENEWEAVER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SCENEWEAVER_RUNTIME_DIR=runtime
SCENEWEAVER_DATABASE_URL=sqlite:///runtime/studio.db
SCENEWEAVER_WORKER_ID=worker-local-1
SCENEWEAVER_JOB_LEASE_SECONDS=30
SCENEWEAVER_FAKE_IMAGE_DELAY_MS=200

# LLM (optional; default stub)
SCENEWEAVER_LLM_PROVIDER=stub
# SCENEWEAVER_LLM_PROVIDER=openai_compatible
# SCENEWEAVER_LLM_BASE_URL=https://api.openai.com/v1
# SCENEWEAVER_LLM_API_KEY=
# SCENEWEAVER_LLM_MODEL=gpt-4o-mini

# Image backend: fake | comfy | comfy_dry
SCENEWEAVER_IMAGE_BACKEND=fake

# ComfyUI (required when IMAGE_BACKEND=comfy)
# Prefer SCENEWEAVER_COMFY_URL; live scripts also accept COMFY_BASE_URL
SCENEWEAVER_COMFY_URL=http://127.0.0.1:8188
# COMFY_BASE_URL=http://127.0.0.1:8188
SCENEWEAVER_COMFY_POLL_TIMEOUT_SECONDS=300
SCENEWEAVER_COMFY_POLL_INTERVAL_SECONDS=2

# --- E2E (set by scripts/e2e/*; do not use in production) ---
# SCENEWEAVER_ENVIRONMENT=e2e
# SCENEWEAVER_RUNTIME_DIR=runtime-e2e
# SCENEWEAVER_PORT=8010

# --- Live Comfy smoke (set by scripts/e2e/start-live-stack.sh) ---
# SCENEWEAVER_ENVIRONMENT=live-test
# SCENEWEAVER_RUNTIME_DIR=runtime-live-test
# SCENEWEAVER_IMAGE_BACKEND=comfy
# SCENEWEAVER_PORT=8020
# SCENEWEAVER_COMFY_POLL_TIMEOUT_SECONDS=600

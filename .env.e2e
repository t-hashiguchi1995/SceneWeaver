# SceneWeaver E2E — isolated from local `runtime/`
SCENEWEAVER_ENVIRONMENT=e2e
SCENEWEAVER_HOST=127.0.0.1
SCENEWEAVER_PORT=8010
SCENEWEAVER_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
SCENEWEAVER_RUNTIME_DIR=runtime-e2e
SCENEWEAVER_DATABASE_URL=sqlite:///runtime-e2e/studio.db
SCENEWEAVER_WORKER_ID=e2e-worker-1
SCENEWEAVER_JOB_LEASE_SECONDS=30
SCENEWEAVER_FAKE_IMAGE_DELAY_MS=400
SCENEWEAVER_LLM_PROVIDER=stub
SCENEWEAVER_IMAGE_BACKEND=fake
